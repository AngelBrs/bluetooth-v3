{
    "name": "pxt-bluetoothV3",
    "version": "0.0.1",
    "description": "Full Bluetooth V2 custom blocks for micro:bit",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "main.ts",
        "README.md"
    ],
    "public": true,
    "targetVersions": {
        "target": "8.0.18",
        "targetId": "microbit"
    },
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
